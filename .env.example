# Uses the live service. Account changes and withdrawals affect the configured member.
# Copy to .env locally and fill authorized values. Never commit credentials.
DEMO_API_BASE_URL=https://saas.tbxzs.cn
DEMO_APP_KEY=replace-with-app-key
DEMO_APP_SECRET=replace-with-app-secret
DEMO_OPENID=replace-with-authorized-member-openid
DEMO_ORGANIZATION_ID=0
DEMO_TEAM_ID=0
DEMO_PORT=8787
# For phone debugging only: bind to this computer's private Wi-Fi IPv4 address.
# No authentication on the LAN HTTP listener: use only an isolated network and test credentials.
# Do not expose the HTTP demo backend on the Internet or use an account with real funds.
# DEMO_LAN_HOST=192.168.1.10
