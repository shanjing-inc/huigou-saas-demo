.shell { min-height: 100vh; padding: 42rpx 34rpx 80rpx; box-sizing: border-box; }
.shell.showcase-shell { padding: 0 0 56rpx; background: #f6f6f6; }
.app-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 92rpx; margin: -42rpx -34rpx 0; background: #fff; box-sizing: content-box; }
.showcase-shell .app-nav { margin: 0; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #262626; }
.nav-back { position: absolute; left: 16rpx; bottom: 0; width: 80rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; font-size: 64rpx; font-weight: 300; color: #232323; }
.showcase-label { text-align: right; padding: 4rpx 22rpx; color: #9c5246; background: #fff; font-size: 18rpx; }
.showcase-shell .alert,.showcase-shell .notice { margin: 8rpx 20rpx; }
.topline { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.mark { font-size: 20rpx; font-weight: 700; color: #186454; }
.demo-tag { color: #873b32; background: #fff0ea; font-size: 20rpx; padding: 8rpx 12rpx; border-radius: 6rpx; flex-shrink: 0; }
.page-title { font-size: 48rpx; font-weight: 700; margin-top: 36rpx; }
.subtitle { font-size: 24rpx; color: #66756f; margin-top: 8rpx; }
.tabs { white-space: nowrap; width: 100%; border-bottom: 1rpx solid #dce4df; margin-top: 38rpx; }
.tabs-inner { display: flex; width: max-content; }
.tab { padding: 24rpx 24rpx; color: #63736b; font-size: 26rpx; flex-shrink: 0; }
.tab.active { color: #075d4b; border-bottom: 4rpx solid #08755c; font-weight: 700; }
.section { margin-top: 34rpx; }
.section-head { font-weight: 700; font-size: 32rpx; margin-bottom: 22rpx; }
.eyebrow { color: #186454; font-size: 18rpx; font-weight: 700; margin-left: 10rpx; }
.hint,.meta,.empty { color: #67776f; font-size: 24rpx; line-height: 1.6; }
.empty { padding: 55rpx 16rpx; text-align: center; background: #eff3f1; border-radius: 8rpx; margin: 20rpx 0; }
.alert,.notice { padding: 22rpx; margin-top: 24rpx; border-radius: 6rpx; font-size: 24rpx; line-height: 1.5; }
.alert { color: #923528; background: #fff0ea; }
.notice { color: #125d4c; background: #e4f5eb; }
button { margin: 22rpx 0 0; font-size: 26rpx; height: 82rpx; line-height: 82rpx; }
button::after { border: 0; }
.primary { background: #08755c; color: white; }
.quiet { color: #075d4b; border: 1rpx solid #a5bcb0; background: transparent; }
.stat,.record-row { display: flex; justify-content: space-between; gap: 20rpx; align-items: center; }
.stat { padding: 23rpx 0; border-bottom: 1rpx solid #e0e6e2; font-size: 26rpx; }
.stat text:first-child { color: #64746e; }
.material-input { width: 100%; height: 170rpx; box-sizing: border-box; border: 1rpx solid #bbcfc3; border-radius: 6rpx; padding: 20rpx; background: #fff; font-size: 26rpx; }
.subhead { font-size: 26rpx; font-weight: 700; margin: 38rpx 0 16rpx; }
.candidate,.result { border: 1rpx solid #d6e2d9; background: white; border-radius: 8rpx; margin: 14rpx 0; padding: 22rpx; }
.candidate { display: flex; align-items: flex-start; gap: 20rpx; }
.candidate.chosen { border-color: #08755c; background: #f0f8f4; }
.candidate-photo { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 6rpx; overflow: hidden; background: #edf1ee; }
.candidate-photo image,.photo-fallback { width: 100%; height: 100%; }
.photo-fallback { display: flex; align-items: center; justify-content: center; color: #84928a; font-size: 21rpx; }
.candidate-body { flex: 1; min-width: 0; }
.candidate-body .candidate-title { line-height: 1.4; max-height: 2.8em; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.candidate-offer { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.candidate-price { font-size: 30rpx; font-weight: 700; color: #20332e; }
.candidate-missing { margin-top: 12rpx; font-size: 22rpx; color: #7b8880; }
.candidate-coupon { background: #ffede5; color: #ae432c; padding: 3rpx 9rpx; border-radius: 6rpx; font-size: 21rpx; }
.candidate-rebate { display: inline-block; border: 1rpx solid #db6550; border-radius: 6rpx; color: #b74a36; padding: 2rpx 9rpx; margin-top: 10rpx; font-size: 22rpx; }
.candidate-bottom { display: flex; justify-content: space-between; gap: 10rpx; color: #7b8880; font-size: 21rpx; margin-top: 12rpx; }
.candidate-shop { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.candidate-state { flex-shrink: 0; }
.candidate-title,.strong { font-weight: 600; font-size: 26rpx; overflow-wrap: anywhere; }
.url-text { font-size: 22rpx; color: #286650; overflow-wrap: anywhere; line-height: 1.5; margin-top: 10rpx; }
.type-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.type { font-size: 24rpx; border: 1rpx solid #c9d7cf; padding: 12rpx 18rpx; border-radius: 6rpx; }
.type.selected { background: #08755c; color: white; border-color: #08755c; }
.actions { display: flex; gap: 14rpx; }
.actions .half { flex: 1; font-size: 24rpx; padding: 0 8rpx; }
.record { border-bottom: 1rpx solid #dce5df; padding: 22rpx 0; }
.record-row text { font-size: 25rpx; overflow-wrap: anywhere; }
.record .meta { margin-top: 8rpx; }
.orders-section { margin: 0; }
.record.order-record { padding: 0; border: 0; margin: 0 0 10rpx; background: #fff; }
.order-head,.order-ident,.order-good-meta,.order-times { display: flex; align-items: center; }
.order-head { justify-content: space-between; padding: 12rpx 20rpx; gap: 12rpx; border-bottom: 1rpx solid #eee; }
.order-ident { min-width: 0; gap: 9rpx; flex-wrap: wrap; }
.order-platform { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 5rpx; color: #fff; background: #ff5639; font-size: 21rpx; }
.order-number { min-width: 0; color: #777; font-size: 21rpx; overflow-wrap: anywhere; }
.order-platform-name { flex-shrink: 0; color: #808080; font-size: 19rpx; }
.copy-order { flex-shrink: 0; margin: 0; height: 44rpx; line-height: 42rpx; padding: 0 9rpx; font-size: 19rpx; color: #ee694f; border: 1rpx solid #ff9a84; background: #fff; border-radius: 6rpx; }
.order-reason { padding: 7rpx 20rpx; color: #999; background: #f1f1f1; font-size: 19rpx; }
.order-goods { padding: 0 20rpx; }
.order-good { display: flex; align-items: center; gap: 16rpx; padding: 15rpx 0; border-bottom: 1rpx solid #f1f1f1; }
.order-photo { width: 96rpx; height: 96rpx; flex-shrink: 0; overflow: hidden; background: #f2f2f2; }
.order-photo image,.order-photo .photo-fallback { width: 100%; height: 100%; }
.order-good-info { min-width: 0; flex: 1; }
.order-title { color: #515151; font-size: 22rpx; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow-wrap: anywhere; }
.order-state { border: 1rpx solid #65c889; border-radius: 5rpx; color: #45b470; font-size: 17rpx; padding: 0 4rpx; margin-right: 8rpx; }
.order-state.closed { border-color: #bbb; color: #999; }
.order-good-meta { gap: 22rpx; flex-wrap: wrap; margin-top: 8rpx; }
.order-price { font-size: 27rpx; color: #242424; font-weight: 700; }
.order-rebate { color: #ff6247; font-size: 25rpx; font-weight: 700; }
.order-rebate-tag { padding: 2rpx 6rpx; border-radius: 5rpx; background: #ff6247; color: #fff; font-size: 18rpx; font-weight: 400; }
.order-settle-note,.order-missing { color: #999; font-size: 20rpx; }
.order-missing { padding: 20rpx; }
.order-times { justify-content: space-between; gap: 8rpx; padding: 12rpx 20rpx; color: #999; font-size: 19rpx; line-height: 1.5; }
.order-times text:first-child { min-width: 0; overflow-wrap: anywhere; }
.order-detail-toggle { flex-shrink: 0; color: #777; font-size: 20rpx; }
.order-details { padding: 12rpx 20rpx 20rpx; border-top: 1rpx solid #eee; color: #777; font-size: 21rpx; line-height: 1.7; }
.wallet-section { background: #f6f6f6; }
.wallet-balance { background: #ff6247; color: #fff; padding: 26rpx 24rpx 20rpx; }
.wallet-balance-label { font-size: 21rpx; }
.wallet-balance-main { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 3rpx; }
.wallet-amount { font-size: 54rpx; font-weight: 400; overflow-wrap: anywhere; min-width: 0; }
.wallet-history { flex-shrink: 0; margin: 0; height: 50rpx; line-height: 50rpx; padding: 0 15rpx; font-size: 20rpx; border-radius: 28rpx; background: #fff; color: #f05f49; }
.wallet-summary { display: flex; margin-top: 24rpx; }
.wallet-summary > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 0 4rpx; text-align: center; font-size: 18rpx; line-height: 1.4; }
.wallet-summary-value { font-size: 25rpx; overflow-wrap: anywhere; }
.wallet-periods { display: flex; margin-top: 10rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.wallet-period { flex: 1; padding: 24rpx 0; text-align: center; font-size: 24rpx; color: #363636; }
.wallet-period.selected { color: #ff6247; border-bottom: 3rpx solid #ff6247; font-weight: 600; }
.wallet-data-note { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 14rpx 22rpx; color: #888; font-size: 19rpx; }
.wallet-refresh { flex-shrink: 0; color: #eb6048; padding: 3rpx 10rpx; }
.wallet-stat-row { margin: 0 12rpx 10rpx; padding: 14rpx 16rpx 12rpx; border-radius: 8rpx; background: #fff; }
.wallet-stat-top { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; padding-bottom: 12rpx; font-size: 22rpx; color: #383838; border-bottom: 1rpx solid #f1f1f1; }
.wallet-stat-top text:last-child { color: #999; font-size: 19rpx; }
.wallet-stat-values { display: flex; padding: 12rpx 0 3rpx; }
.wallet-stat-metric { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 5rpx; padding: 8rpx; }
.wallet-stat-metric + .wallet-stat-metric { border-left: 1rpx solid #f1f1f1; }
.wallet-stat-label { color: #999; font-size: 20rpx; text-align: center; }
.wallet-stat-value { color: #393939; font-size: 27rpx; line-height: 1.5; overflow-wrap: anywhere; text-align: center; }
.wallet-more { margin: 20rpx; }
.wallet-hint { margin: 20rpx 24rpx; color: #888; font-size: 20rpx; line-height: 1.5; }
.showcase-shell .empty { margin: 12rpx; background: #fff; }
.showcase-shell .footer { margin-top: 45rpx; }
.footer { font-size: 20rpx; color: #889790; text-align: center; margin-top: 90rpx; }
