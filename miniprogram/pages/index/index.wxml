<view class="shell {{mode === 'orders' || mode === 'wallet' ? 'showcase-shell' : ''}}">
    <view class="app-nav" style="padding-top: {{statusBarHeight}}px">
        <view wx:if="{{mode === 'orders' || mode === 'wallet'}}" class="nav-back" role="button" aria-label="返回成员页面" bindtap="backToProfile">‹</view>
        <text class="nav-title">{{mode === 'orders' ? '订单列表' : mode === 'wallet' ? '我的钱包' : '返利联调'}}</text>
    </view>
    <view wx:if="{{mode !== 'orders' && mode !== 'wallet'}}" class="topline"><text class="mark">HUIGOU / PARTNER</text><text class="demo-tag">隔离测试 · DEMO</text></view>
    <view wx:if="{{mode !== 'orders' && mode !== 'wallet'}}" class="page-title">返利联调</view>
    <view wx:if="{{mode !== 'orders' && mode !== 'wallet'}}" class="subtitle">真实测试接口 · 只读资金记录</view>
    <view wx:else class="showcase-label">隔离测试 · DEMO</view>

    <view wx:if="{{error}}" class="alert" role="alert">{{error}}</view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>

    <view wx:if="{{!connected}}" class="section">
        <view class="section-head">测试成员</view>
        <view class="hint">身份和应用凭证仅由本机后端提供；小程序不会调用微信登录。</view>
        <view wx:if="{{backendReachable && !configured}}" class="empty">尚未配置隔离测试凭证。请检查本机 .env 并重启后端。</view>
        <button wx:if="{{!configured}}" class="quiet" disabled="{{checkingBackend}}" loading="{{checkingBackend}}" bindtap="checkBackend">重新检测本机后端</button>
        <button class="primary" disabled="{{busy || !configured}}" loading="{{busy}}" bindtap="connect">连接测试环境</button>
    </view>

    <block wx:else>
        <scroll-view wx:if="{{mode !== 'orders' && mode !== 'wallet'}}" class="tabs" scroll-x="true" enable-flex="true">
            <view class="tabs-inner">
                <view class="tab {{mode === 'profile' ? 'active' : ''}}" data-mode="profile" bindtap="changeTab">成员</view>
                <view class="tab {{mode === 'promote' ? 'active' : ''}}" data-mode="promote" bindtap="changeTab">推广</view>
                <view class="tab {{mode === 'orders' ? 'active' : ''}}" data-mode="orders" bindtap="changeTab">订单</view>
                <view class="tab {{mode === 'wallet' ? 'active' : ''}}" data-mode="wallet" bindtap="changeTab">钱包</view>
                <view class="tab {{mode === 'bills' ? 'active' : ''}}" data-mode="bills" bindtap="changeTab">账单</view>
                <view class="tab {{mode === 'withdrawals' ? 'active' : ''}}" data-mode="withdrawals" bindtap="changeTab">提现</view>
            </view>
        </scroll-view>

        <view wx:if="{{mode === 'profile'}}" class="section">
            <view class="section-head">成员资料 <text class="eyebrow">LIVE TEST</text></view>
            <view class="stat"><text>成员 ID</text><text>{{profile.memberId}}</text></view>
            <view class="stat"><text>Team ID</text><text>{{profile.teamId}}</text></view>
            <view class="stat"><text>角色</text><text>{{profile.role}}</text></view>
            <view class="stat"><text>可用余额</text><text>¥ {{profile.money}}</text></view>
            <view class="stat"><text>待结算</text><text>¥ {{profile.pendingMoney}}</text></view>
            <view class="stat"><text>累计提现</text><text>¥ {{profile.withdrawalMoney}}</text></view>
            <button class="quiet" disabled="{{busy}}" bindtap="disconnect">断开会话</button>
        </view>

        <view wx:elif="{{mode === 'wallet'}}" class="wallet-section">
            <view class="wallet-balance">
                <view class="wallet-balance-label">可用余额 (元)</view>
                <view class="wallet-balance-main"><text class="wallet-amount">{{walletLoaded ? profile.money : '—'}}</text><button class="wallet-history" data-mode="withdrawals" bindtap="changeTab">提现记录 ›</button></view>
                <view class="wallet-summary">
                    <view><text>已提现金额</text><text class="wallet-summary-value">{{walletLoaded ? profile.withdrawalMoney : '—'}}</text></view>
                    <view><text>待结算及提现中</text><text class="wallet-summary-value">{{walletLoaded ? profile.pendingMoney : '—'}}</text></view>
                </view>
            </view>
            <view class="wallet-periods">
                <view class="wallet-period {{walletPeriod === 'day' ? 'selected' : ''}}" data-period="day" bindtap="changeWalletPeriod">按天查看</view>
                <view class="wallet-period {{walletPeriod === 'month' ? 'selected' : ''}}" data-period="month" bindtap="changeWalletPeriod">按月查看</view>
                <view class="wallet-period {{walletPeriod === 'year' ? 'selected' : ''}}" data-period="year" bindtap="changeWalletPeriod">按年查看</view>
            </view>
            <view class="wallet-data-note"><text>仅显示有记录的时段 · {{walletPeriod === 'day' ? '近30个业务日' : '近366个业务日'}}</text><text class="wallet-refresh" role="button" bindtap="refreshWallet">刷新</text></view>
            <view wx:if="{{busy && !walletLoaded}}" class="empty">正在读取成员收益…</view>
            <view wx:elif="{{walletLoaded && !walletStats.length}}" class="empty">该时段暂无收益记录</view>
            <view wx:for="{{walletStats}}" wx:for-item="stat" wx:key="date" class="wallet-stat-row">
                <view class="wallet-stat-top"><text>{{stat.date}} 收益</text><text>{{stat.orderCount}} 笔订单</text></view>
                <view class="wallet-stat-values">
                    <view class="wallet-stat-metric"><text class="wallet-stat-label">新增预估返利</text><text class="wallet-stat-value">¥{{stat.estimateMemberOrderCommission}}</text></view>
                    <view class="wallet-stat-metric"><text class="wallet-stat-label">新增已结算返利</text><text class="wallet-stat-value">¥{{stat.settledMemberOrderCommission}}</text></view>
                </view>
            </view>
            <button wx:if="{{walletHasMore}}" class="quiet wallet-more" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMore">加载更早时段</button>
            <view class="wallet-hint">待结算包含提现中金额。演示页只读，不发起提现。</view>
        </view>

        <view wx:elif="{{mode === 'promote'}}" class="section">
            <view class="section-head">分享物料 <text class="eyebrow">PARSE → LINK</text></view>
            <textarea class="material-input" maxlength="4096" placeholder="粘贴已开通联盟的测试分享文案或商品链接" value="{{content}}" bindinput="updateContent" />
            <button class="primary" loading="{{busy}}" disabled="{{busy || !content}}" bindtap="parse">解析内容</button>
            <view wx:if="{{candidates.length}}" class="subhead">候选内容 · {{candidates.length}}</view>
            <view wx:for="{{candidates}}" wx:key="index" class="candidate {{selectedIndex === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="selectCandidate">
                <view class="candidate-photo">
                    <image wx:if="{{item.preview.imageUrl && !item.imageFailed}}" src="{{item.preview.imageUrl}}" mode="aspectFill" lazy-load="true" data-index="{{index}}" data-version="{{item.version}}" data-image="{{item.preview.imageUrl}}" binderror="candidateImageError" />
                    <view wx:else class="photo-fallback">暂无图片</view>
                </view>
                <view class="candidate-body">
                    <view class="candidate-title">{{item.preview.title || item.detail.itemTitle || (item.type === 'goods' || item.type === 'life' ? '商品信息待补充' : '候选物料')}}</view>
                    <view wx:if="{{item.preview.price || item.preview.coupon}}" class="candidate-offer">
                        <text wx:if="{{item.preview.price}}" class="candidate-price">¥{{item.preview.price}}</text>
                        <text wx:if="{{item.preview.coupon}}" class="candidate-coupon">{{item.preview.coupon}} 元券</text>
                    </view>
                    <view wx:elif="{{item.previewState === 'ready'}}" class="candidate-missing">价格未提供</view>
                    <view wx:if="{{item.preview.rebate}}" class="candidate-rebate">再返 ¥{{item.preview.rebate}}</view>
                    <view class="candidate-bottom">
                        <text class="candidate-shop">{{item.preview.shopName || item.platform}}</text>
                        <text wx:if="{{item.previewState === 'loading'}}" class="candidate-state">详情加载中</text>
                        <text wx:elif="{{item.previewState === 'unavailable'}}" class="candidate-state">详情暂不可用</text>
                        <text wx:elif="{{item.previewState === 'unsupported'}}" class="candidate-state">非商品物料</text>
                    </view>
                </view>
            </view>
            <block wx:if="{{selected}}">
                <view class="subhead">已选候选 · {{selected.platform}}</view>
                <view class="type-row">
                    <view class="type {{selectedType === 'goods' ? 'selected' : ''}}" data-type="goods" bindtap="setType">商品</view>
                    <view class="type {{selectedType === 'activity' ? 'selected' : ''}}" data-type="activity" bindtap="setType">活动</view>
                    <view class="type {{selectedType === 'live' ? 'selected' : ''}}" data-type="live" bindtap="setType">直播</view>
                    <view class="type {{selectedType === 'life' ? 'selected' : ''}}" data-type="life" bindtap="setType">团购</view>
                </view>
                <view class="actions">
                    <button class="quiet half" disabled="{{busy || (selectedType !== 'goods' && selectedType !== 'life')}}" bindtap="getItem">刷新商品详情</button>
                    <button class="primary half" disabled="{{busy}}" loading="{{busy}}" bindtap="createLink">生成转链</button>
                </view>
                <view wx:if="{{link}}" class="result">
                    <view class="subhead">推广结果 <text class="eyebrow">LIVE TEST</text></view>
                    <view class="url-text">{{link.url}}</view>
                    <view wx:if="{{link.shortUrl}}" class="meta">短链：{{link.shortUrl}}</view>
                    <view wx:if="{{link.code}}" class="meta">口令：{{link.code}}</view>
                    <view wx:if="{{link.miniProgram}}" class="meta">小程序：{{link.miniProgram.appId}} / {{link.miniProgram.path}}</view>
                    <button class="quiet" bindtap="copyLink">复制落地链接</button>
                </view>
            </block>
        </view>

        <view wx:else class="section {{mode === 'orders' ? 'orders-section' : ''}}">
            <view wx:if="{{mode !== 'orders'}}" class="section-head">{{mode === 'bills' ? '我的账单' : '提现记录'}} <text class="eyebrow">LIVE TEST</text></view>
            <view wx:if="{{busy && !loaded}}" class="empty">正在读取测试环境…</view>
            <view wx:elif="{{loaded && !records.length}}" class="empty">测试环境暂无记录。转链成功不会立即产生订单。</view>
            <view wx:for="{{records}}" wx:key="id" class="record {{mode === 'orders' ? 'order-record' : ''}}">
                <block wx:if="{{mode === 'orders'}}">
                    <view class="order-head">
                        <view class="order-ident"><text class="order-platform">{{item.platformMark}}</text><text class="order-number">订单号：{{item.orderSn || '未提供'}}</text><text class="order-platform-name">{{item.platformLabel}}</text></view>
                        <button class="copy-order" size="mini" disabled="{{!item.orderSn}}" data-id="{{item.id}}" bindtap="copyOrderSn">复制单号</button>
                    </view>
                    <view wx:if="{{item.detail.invalidReason}}" class="order-reason">{{item.detail.invalidReason}}</view>
                    <view wx:if="{{item.goods.length}}" class="order-goods">
                        <view wx:for="{{item.goods}}" wx:for-item="good" wx:for-index="goodIndex" wx:key="index" class="order-good">
                            <view class="order-photo">
                                <image wx:if="{{good.imageUrl && !good.imageFailed}}" src="{{good.imageUrl}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" data-index="{{goodIndex}}" data-image="{{good.imageUrl}}" binderror="orderImageError" />
                                <view wx:else class="photo-fallback">暂无图片</view>
                            </view>
                            <view class="order-good-info">
                                <view class="order-title"><text class="order-state {{item.status === -1 || item.status === -2 ? 'closed' : ''}}">{{item.statusLabel}}</text>{{good.itemTitle || '商品名称暂缺'}}</view>
                                <view class="order-good-meta"><text class="order-price">{{item.goods.length > 1 ? (good.itemPrice != null ? '单价 ¥ ' + good.itemPrice : '单价暂缺') : (item.displayPrice !== null ? '¥ ' + item.displayPrice : '金额暂缺')}}</text><text wx:if="{{item.hasRebate && goodIndex === 0}}" class="order-rebate"><text class="order-rebate-tag">{{item.goods.length > 1 ? '整单' : ''}}{{item.settleStatus === 1 ? '预计返' : '返'}}</text> {{item.rebateMoney != null ? item.rebateMoney : '—'}}</text><text wx:elif="{{!item.hasRebate && goodIndex === 0}}" class="order-settle-note">{{item.settleLabel}}</text></view>
                            </view>
                        </view>
                    </view>
                    <view wx:else class="order-missing">商品明细暂未提供 · {{item.statusLabel}}</view>
                    <view class="order-times"><text>下单{{item.confirmDate ? '/收货' : ''}}{{item.rebateDate ? (item.settleStatus === 1 ? '/预计结算' : '/已结算') : ''}}时间：{{item.orderDate || '—'}}{{item.confirmDate ? '/' + item.confirmDate : ''}}{{item.rebateDate ? '/' + item.rebateDate : ''}}</text><text class="order-detail-toggle" role="button" data-id="{{item.id}}" bindtap="toggleOrderDetail">{{item.expanded ? '收起' : '详情'}}⌄</text></view>
                    <view wx:if="{{item.expanded}}" class="order-details">
                        <view wx:if="{{item.detail.payPrice}}">实付金额 ¥{{item.detail.payPrice}}</view>
                        <view wx:if="{{item.paidAmount}}">计佣金额 ¥{{item.paidAmount}}</view>
                        <view wx:if="{{item.hasRefund}}">累计退款 ¥{{item.refundMoney}}</view>
                        <view wx:for="{{item.goods}}" wx:for-item="good" wx:key="index"><text wx:if="{{good.itemPrice}}">单价 ¥{{good.itemPrice}}　</text><text wx:if="{{good.itemNum}}">数量 ×{{good.itemNum}}</text></view>
                        <view wx:if="{{item.paidAt}}">付款 {{item.paidAt}}</view>
                        <view wx:if="{{item.confirmedAt}}">收货 {{item.confirmedAt}}</view>
                        <view wx:if="{{item.closedAt}}">关闭 {{item.closedAt}}</view>
                        <view wx:if="{{item.settleStatus === 1 && item.expectedSettleAt}}">预计结算 {{item.expectedSettleAt}}</view>
                        <view wx:if="{{item.settleStatus === 3 && item.settledAt}}">返利结清 {{item.settledAt}}</view>
                    </view>
                </block>
                <block wx:elif="{{mode === 'bills'}}">
                    <view class="record-row"><text class="strong">账单 #{{item.id}}</text><text>¥ {{item.amount}}</text></view>
                    <view class="meta">{{item.createdAt}} · {{item.action === 1 ? '增加' : '减少'}} · 事件 {{item.event}} · {{item.memo}}</view>
                </block>
                <block wx:else>
                    <view class="record-row"><text class="strong">提现 #{{item.id}}</text><text>¥ {{item.amount}}</text></view>
                    <view class="meta">{{item.createdAt}} · {{item.statusLabel}}</view>
                </block>
            </view>
            <button wx:if="{{hasMore}}" class="quiet" disabled="{{busy}}" loading="{{busy}}" bindtap="loadMore">加载下一页</button>
        </view>
    </block>
    <view class="footer">演示环境 · 非生产资金操作</view>
</view>
